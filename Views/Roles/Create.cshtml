@model Blog.ViewModels.CreateRoleInput
@{
    ViewData["Title"] = "Добавление роли";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h1 class="h2 mb-4">Добавление роли</h1>
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="form-group">
                    <label asp-for="Name">Название</label>
                    <input asp-for="Name" class="form-control" maxlength="256" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Description">Описание</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary">Добавить</button>
            </form>
            <p class="mt-4"><a asp-action="Index">Перейти к списку всех ролей</a></p>
        </div>
    </div>
</section>
