@model IReadOnlyList<Blog.Services.TagResponse>
@{
    ViewData["Title"] = "Теги";
}

<section class="container py-5">
    <h1 class="mb-4">Теги</h1>

    @if (Model.Count == 0)
    {
        <p>Тегов пока нет.</p>
    }
    else
    {
        <ul>
            @foreach (var tag in Model)
            {
                <li>@tag.Name</li>
            }
        </ul>
    }
</section>
