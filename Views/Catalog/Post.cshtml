@model Blog.ViewModels.PostDetailsInput
@using System.Security.Claims
@{
    ViewData["Title"] = Model.Details.Title;
    var post = Model.Details;
    var canComment = User.IsInRole(Blog.Services.RoleNames.Admin) ||
        (User.IsInRole(Blog.Services.RoleNames.User) &&
         !User.IsInRole(Blog.Services.RoleNames.Moderator));
}

<article class="container py-5">
    <p><a asp-action="Posts">Все статьи</a></p>
    <h1>@post.Title</h1>
    @if (post.Tags.Length > 0)
    {
        <div class="mb-3">
            @foreach (var tag in post.Tags)
            {
                <a class="badge badge-info mr-1" asp-action="Posts" asp-route-tagId="@tag.Id">@tag.Name</a>
            }
        </div>
    }
    <p class="text-muted">@post.CreatedAtUtc.ToString("dd.MM.yyyy")</p>
    <div class="mb-4" style="white-space: pre-wrap">@post.Content</div>
    <p class="text-muted">Автор: @post.AuthorName</p>
    @if (User.IsInRole(Blog.Services.RoleNames.Admin) ||
         User.IsInRole(Blog.Services.RoleNames.Moderator) ||
         (User.IsInRole(Blog.Services.RoleNames.User) &&
          post.AuthorId == User.FindFirstValue(ClaimTypes.NameIdentifier)))
    {
        <p><a asp-action="EditPost" asp-route-id="@post.Id">Редактировать</a></p>
    }
    @if (User.IsInRole(Blog.Services.RoleNames.Admin) ||
         (User.IsInRole(Blog.Services.RoleNames.User) &&
          !User.IsInRole(Blog.Services.RoleNames.Moderator) &&
          post.AuthorId == User.FindFirstValue(ClaimTypes.NameIdentifier)))
    {
        <p><a asp-action="DeletePost" asp-route-id="@post.Id">Удалить</a></p>
    }

    <hr />
    <h2 class="h4 mb-3" id="comments">Комментарии к статье</h2>
    @if (post.Comments.Length == 0)
    {
        <p>Комментариев пока нет.</p>
    }
    else
    {
        @foreach (var comment in post.Comments)
        {
            <div class="border rounded p-3 mb-3">
                <p class="mb-2" style="white-space: pre-wrap">@comment.Content</p>
                <p class="text-muted small mb-0">@comment.AuthorName · @comment.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm")</p>
                <a asp-controller="Discussion" asp-action="Details" asp-route-id="@comment.Id">Просмотреть</a>
            </div>
        }
    }

    @if (canComment)
    {
        <p><a asp-controller="Discussion" asp-action="Create" asp-route-postId="@post.Id">Открыть страницу добавления комментария</a></p>
        <form asp-action="AddComment" asp-route-id="@post.Id" method="post" class="mt-4">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="form-group">
                <label asp-for="CommentText">Ваш комментарий</label>
                <textarea asp-for="CommentText" class="form-control" rows="4" maxlength="2000"></textarea>
                <span asp-validation-for="CommentText" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary">Оставить комментарий</button>
        </form>
    }
    else if (User.Identity?.IsAuthenticated != true)
    {
        <p><a asp-area="Identity" asp-page="/Account/Login">Войдите</a>, чтобы оставить комментарий.</p>
    }
</article>
