@model Blog.Services.PostResponse
@using System.Security.Claims
@{
    ViewData["Title"] = Model.Title;
}

<article class="container py-5">
    <p><a asp-action="Posts">Все статьи</a></p>
    <h1>@Model.Title</h1>
    <p class="text-muted">@Model.CreatedAtUtc.ToString("dd.MM.yyyy")</p>
    <p>@Model.Content</p>
    @if (User.IsInRole(Blog.Services.RoleNames.Admin) ||
         User.IsInRole(Blog.Services.RoleNames.Moderator) ||
         (User.IsInRole(Blog.Services.RoleNames.User) &&
          Model.AuthorId == User.FindFirstValue(ClaimTypes.NameIdentifier)))
    {
        <p><a asp-action="EditPost" asp-route-id="@Model.Id">Редактировать</a></p>
    }
</article>
