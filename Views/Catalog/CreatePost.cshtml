@model Blog.ViewModels.CreatePostInput
@{
    ViewData["Title"] = "Добавление статьи";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h1 class="h2 mb-4">Добавление статьи</h1>
            <form asp-action="CreatePost" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <fieldset class="form-group">
                    <legend class="h6">Теги</legend>
                    @if (Model.AvailableTags.Count == 0)
                    {
                        <p>Тегов пока нет. <a asp-action="CreateTag">Добавить тег</a></p>
                    }
                    else
                    {
                        @foreach (var tag in Model.AvailableTags)
                        {
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" name="TagIds" id="tag-@tag.Id"
                                       value="@tag.Id" checked="@Model.TagIds.Contains(tag.Id)" />
                                <label class="form-check-label" for="tag-@tag.Id">@tag.Name</label>
                            </div>
                        }
                    }
                </fieldset>

                <div class="form-group">
                    <label asp-for="Title">Заголовок</label>
                    <input asp-for="Title" class="form-control" maxlength="200" required />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Content">Текст статьи</label>
                    <textarea asp-for="Content" class="form-control" rows="8" required></textarea>
                    <span asp-validation-for="Content" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary">Добавить</button>
            </form>
            <p class="mt-4"><a asp-action="Posts">Вернуться к списку всех статей</a></p>
        </div>
    </div>
</section>
