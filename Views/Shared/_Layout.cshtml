<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Блог</title>
    <link rel="stylesheet" href="~/vendor/bootstrap/bootstrap.min.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="border-bottom">
        <div class="container py-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between">
                <a class="h4 mb-0" asp-area="" asp-controller="Home" asp-action="Index">Блог</a>
                <partial name="_LoginPartial" />
            </div>
            <nav class="mt-3" aria-label="Основное меню">
                <a class="mr-3" asp-area="" asp-controller="Home" asp-action="Index">Главная</a>
                <a class="mr-3" asp-area="" asp-controller="Catalog" asp-action="Posts">Статьи</a>
                <a class="mr-3" asp-area="" asp-controller="Catalog" asp-action="Tags">Теги</a>
                <a class="mr-3" asp-area="" asp-controller="Discussion" asp-action="Index">Комментарии</a>
                @if (User.IsInRole(Blog.Services.RoleNames.Admin))
                {
                    <a class="mr-3" asp-area="" asp-controller="Roles" asp-action="Index">Роли</a>
                    <a asp-area="" asp-controller="Accounts" asp-action="Index">Пользователи</a>
                }
            </nav>
        </div>
    </header>
    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="border-top mt-auto py-3">
        <div class="container text-muted">
            Блог, @DateTime.UtcNow.Year
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
