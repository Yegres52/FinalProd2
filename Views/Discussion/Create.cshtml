@model Blog.ViewModels.CommentTextInput
@{
    ViewData["Title"] = "Добавление комментария";
    var postId = (int)ViewData["PostId"]!;
}

<section class="container py-5">
    <h1 class="h2 mb-4">Добавление комментария</h1>
    <p>К статье: @ViewData["PostTitle"]</p>
    <form asp-action="Create" asp-route-postId="@postId" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="form-group"><label asp-for="Content">Комментарий</label><textarea asp-for="Content" class="form-control" rows="5" maxlength="2000"></textarea></div>
        <button class="btn btn-primary" type="submit">Добавить</button>
    </form>
    <p class="mt-4"><a asp-controller="Catalog" asp-action="Post" asp-route-id="@postId">Вернуться к статье</a></p>
</section>
