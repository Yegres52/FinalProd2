@model IReadOnlyList<Blog.Services.CommentDisplayResponse>
@using System.Security.Claims
@{ ViewData["Title"] = "Все комментарии"; }

<section class="container py-5">
    <h1 class="mb-4">Все комментарии</h1>
    @if (Model.Count == 0)
    {
        <p>Комментариев пока нет.</p>
    }
    else
    {
        <div class="row">
            @foreach (var comment in Model)
            {
                <div class="col-md-6 mb-4"><article class="card h-100"><div class="card-body">
                    <p class="mb-2">@comment.Content</p>
                    <p class="text-muted small">@comment.AuthorName · @comment.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm")</p>
                    <p>К статье: <a asp-controller="Catalog" asp-action="Post" asp-route-id="@comment.PostId">@comment.PostTitle</a></p>
                    <a asp-action="Details" asp-route-id="@comment.Id">Просмотреть</a>
                    @if (User.IsInRole(Blog.Services.RoleNames.Admin) ||
                         User.IsInRole(Blog.Services.RoleNames.Moderator) ||
                         comment.AuthorId == User.FindFirstValue(ClaimTypes.NameIdentifier))
                    {
                        <a class="ml-3" asp-action="Edit" asp-route-id="@comment.Id">Редактировать</a>
                    }
                    @if (User.IsInRole(Blog.Services.RoleNames.Admin) ||
                         (!User.IsInRole(Blog.Services.RoleNames.Moderator) &&
                          comment.AuthorId == User.FindFirstValue(ClaimTypes.NameIdentifier)))
                    {
                        <a class="ml-3" asp-action="Delete" asp-route-id="@comment.Id">Удалить</a>
                    }
                </div></article></div>
            }
        </div>
    }
</section>
