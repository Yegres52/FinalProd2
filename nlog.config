<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true" throwConfigExceptions="true">
  <targets>
    <target xsi:type="File" name="actions"
            fileName="${basedir}/logs/actions-${shortdate}.log"
            layout="${longdate} | ${message}" />
    <target xsi:type="File" name="errors"
            fileName="${basedir}/logs/errors-${shortdate}.log"
            layout="${longdate} | ${level:uppercase=true} | ${logger} | ${message}${onexception:inner= | ${exception:format=tostring}}" />
  </targets>
  <rules>
    <logger name="Blog.UserActions" minLevel="Info" maxLevel="Info" writeTo="actions" final="true" />
    <logger name="Blog.HttpErrors" minLevel="Warn" writeTo="errors" final="true" />
    <logger name="Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware" minLevel="Error" final="true" />
    <logger name="*" minLevel="Error" writeTo="errors" />
  </rules>
</nlog>
